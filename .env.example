# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zaadi
DB_PASSWORD=zaadi_dev_password
DB_NAME=zaadi_kitchen
DB_DIALECT=postgres

# JWT
JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_MOBILE=30d
JWT_REFRESH_EXPIRATION_ADMIN=8h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OTP
SKIP_OTP=true
OTP_EXPIRY_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=10

# AWS
AWS_REGION=ap-south-1
S3_BUCKET_NAME=zaadi-kitchen-assets

# Internal jobs (EventBridge triggers)
INTERNAL_JOB_SECRET=change-this-to-a-strong-random-secret

# App
PORT=3000
NODE_ENV=development
