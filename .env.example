# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zaadi
DB_PASSWORD=zaadi_dev_password
DB_NAME=zaadi_kitchen
DB_DIALECT=postgres

# JWT
JWT_SECRET=change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_MOBILE=30d
JWT_REFRESH_EXPIRATION_ADMIN=8h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OTP
SKIP_OTP=true
# Allow +91XXXXXXXXXX for auth testing (Twilio sandbox, dev). Production: omit or false.
OTP_ALLOW_INDIAN_PHONES=true
# Twilio WhatsApp Messaging (OTP) — required when SKIP_OTP=false and channel=whatsapp. SMS uses AWS SNS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886 — production: your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=
# Empty in sandbox (plain text). Production: approved authentication template Content SID (HX...), code as {{1}}
TWILIO_WHATSAPP_CONTENT_SID=
OTP_EXPIRY_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=10

# Play Store review login — fixed OTP for listed phones (enable on staging/review API only)
OTP_REVIEW_ENABLED=false
OTP_REVIEW_ACCOUNTS=+966500000101:1234,+966500000102:1234

# AWS
AWS_REGION=ap-south-1
S3_BUCKET_NAME=zaadikitchen-mum-images-710468208018

# Internal jobs (EventBridge triggers)
INTERNAL_JOB_SECRET=change-this-to-a-strong-random-secret

# ERP integration (Platio-style read APIs)
ERP_API_KEY=change-this-to-a-strong-random-secret
ERP_CUTOFF_TIME_KSA=19:00
ERP_TIMEZONE=Asia/Riyadh

# App
PORT=3000
NODE_ENV=development
