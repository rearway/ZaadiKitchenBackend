              "raw": "{{base_url}}/admin/menu/weeks/{{week_id}}/slots/{{slot_id}}/assign",
              "host": ["{{base_url}}"],
              "path": ["admin", "menu", "weeks", "{{week_id}}", "slots", "{{slot_id}}", "assign"]
