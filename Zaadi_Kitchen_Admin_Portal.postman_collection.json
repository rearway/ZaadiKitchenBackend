{
	"info": {
		"_postman_id": "zk-admin-portal-001",
		"name": "Zaadi Kitchen \u2014 Admin Portal",
		"description": "Admin and Ops portal APIs. Admin Login and Refresh Token auto-save tokens to collection variables. Tokens expire in 15 min \u2014 use Refresh Token to stay logged in.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin_access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Admin Login",
					"auth": {
						"type": "noauth"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data.accessToken) {",
									"    pm.collectionVariables.set('admin_access_token', res.data.accessToken);",
									"    console.log('\u2705 admin_access_token saved');",
									"}",
									"if (res.data && res.data.refreshToken) {",
									"    pm.collectionVariables.set('admin_refresh_token', res.data.refreshToken);",
									"    console.log('\u2705 admin_refresh_token saved');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin@123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/admin/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"admin",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"auth": {
						"type": "noauth"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data.accessToken) {",
									"    pm.collectionVariables.set('admin_access_token', res.data.accessToken);",
									"    console.log('\u2705 admin_access_token refreshed');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{admin_refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						}
					},
					"response": []
				},
				{
					"name": "Admin Logout",
					"request": {
						"method": "POST",
						"header": [],
