{
  "info": {
    "_postman_id": "zk-admin-portal-001",
    "name": "Zaadi Kitchen — Admin Portal",
    "description": "Admin and Ops portal APIs. Admin Login and Refresh Token auto-save tokens to collection variables. Tokens expire in 15 min — use Refresh Token to stay logged in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": [""] }
    },
    {
      "listen": "test",
      "script": { "type": "text/javascript", "exec": [""] }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('admin_access_token', res.data.accessToken);",
                  "    console.log('✅ admin_access_token saved');",
                  "}",
                  "if (res.data && res.data.refreshToken) {",
                  "    pm.collectionVariables.set('admin_refresh_token', res.data.refreshToken);",
                  "    console.log('✅ admin_refresh_token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('admin_access_token', res.data.accessToken);",
                  "    console.log('✅ admin_access_token refreshed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{admin_refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Area Management",
      "item": [
        {
          "name": "List All Areas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/areas",
              "host": ["{{base_url}}"],
              "path": ["admin", "areas"],
              "query": [
                {
                  "key": "status",
                  "value": "active",
                  "description": "Filter: active | coming_soon",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Area",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Downtown Riyadh\",\n    \"description\": \"Core downtown area\",\n    \"status\": \"coming_soon\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/areas",
              "host": ["{{base_url}}"],
              "path": ["admin", "areas"]
            }
          },
          "response": []
        },
        {
          "name": "Add Building to Area",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Al Nakheel Gate Tower\",\n    \"floorsCount\": 22\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/areas/{{area_id}}/buildings",
              "host": ["{{base_url}}"],
              "path": ["admin", "areas", "{{area_id}}", "buildings"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Meal Library",
      "item": [
        {
          "name": "List Meals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/meals?status=all&meal_type=all&page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals"],
              "query": [
                { "key": "status", "value": "all", "description": "all | active | draft" },
                { "key": "meal_type", "value": "all", "description": "all | executive | salad" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" },
                { "key": "q", "value": "", "description": "Search by name (EN or AR)", "disabled": true },
                { "key": "context", "value": "picker", "description": "Use picker mode for meal assignment UI", "disabled": true },
                { "key": "exclude_week_id", "value": "{{week_id}}", "description": "Used with context=picker", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Meal Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/meals/{{meal_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "{{meal_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create Meal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.meal_id) {",
                  "    pm.collectionVariables.set('meal_id', res.meal_id);",
                  "    console.log('✅ meal_id saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name_en\": \"Lamb Kabsa\",\n    \"name_ar\": \"كبسة لحم\",\n    \"meal_type\": \"executive\",\n    \"kcal\": 550,\n    \"macros\": {\n        \"protein_g\": 38,\n        \"carbs_g\": 62,\n        \"fat_g\": 14\n    },\n    \"chef_note\": \"Slow-cooked for 4 hours.\",\n    \"key_ingredients\": [\"Lamb\", \"Saffron rice\"],\n    \"emoji\": \"🍛\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/meals",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals"]
            }
          },
          "response": []
        },
        {
          "name": "Update Meal",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name_en\": \"Updated Name\",\n    \"kcal\": 560\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/meals/{{meal_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "{{meal_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Activate Meal",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/meals/{{meal_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "{{meal_id}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Draft Meal",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"draft\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/meals/{{meal_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "{{meal_id}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Draft Meal (force — in published week)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"draft\",\n    \"confirm_published_edit\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/meals/{{meal_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "{{meal_id}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Import Meals (XLSX)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/meals/import",
              "host": ["{{base_url}}"],
              "path": ["admin", "meals", "import"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Menu Manager",
      "item": [
        {
          "name": "List Weeks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/menu/weeks?count=2",
              "host": ["{{base_url}}"],
              "path": ["admin", "menu", "weeks"],
              "query": [
                { "key": "count", "value": "2", "description": "Number of weeks to return (max 8)" },
                { "key": "from_week", "value": "{{week_id}}", "description": "Week ID to start from e.g. w2025-23", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Week Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/menu/weeks/{{week_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "menu", "weeks", "{{week_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Assign Meal to Slot",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"meal_id\": \"{{meal_id}}\"\n}",
