						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data.accessToken) {",
									"    pm.collectionVariables.set('rider_access_token', res.data.accessToken);",
									"    console.log('\u2705 rider_access_token saved');",
									"}"
								]
							}
						}
