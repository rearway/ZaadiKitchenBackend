          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/menu/weeks/{{week_id}}/slots/{{slot_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "menu", "weeks", "{{week_id}}", "slots", "{{slot_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Publish Week",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/admin/menu/weeks/{{week_id}}/publish",
              "host": ["{{base_url}}"],
              "path": ["admin", "menu", "weeks", "{{week_id}}", "publish"]
            }
          },
          "response": []
        }
      ]
    },
